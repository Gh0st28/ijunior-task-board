{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "node16",
    "moduleResolution": "node16",
    "target": "ES2020",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "ignoreDeprecations": "6.0",
    "types": ["node"]
  },
  "include": ["src"]
}